{
	"name": "@voila.dev/ui-monorepo",
	"version": "0.0.0",
	"private": true,
	"packageManager": "bun@1.3.4",
	"engines": {
		"bun": "1.3.2",
		"node": "23.8.0"
	},
	"scripts": {
		"format": "biome format --write",
		"lint": "biome lint --write",
		"ci": "biome ci",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"check": "turbo run check",
		"lint:all": "turbo run lint",
		"check-types": "turbo run check-types",
		"check-docs": "bun scripts/check-docs.mjs",
		"check-labels": "node scripts/check-email-editor-labels.mjs",
		"storybook:dev": "turbo run dev --filter @voila.dev/storybook.ui.voila.dev",
		"storybook:build": "turbo run build --filter @voila.dev/storybook.ui.voila.dev",
		"docs:dev": "turbo run dev --filter @voila.dev/ui.voila.dev",
		"docs:build": "turbo run build --filter @voila.dev/ui.voila.dev"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@biomejs/biome": "2.5.12",
			"@types/bun": "1.3.14",
			"@types/node": "25.8.0",
			"typescript": "7.0.2",
			"vite": "8.2.2",
			"vitest": "4.1.7"
		},
		"catalogs": {
			"react": {
				"react": "19.3.0",
				"react-dom": "19.3.0",
				"@phosphor-icons/react": "2.1.10"
			},
			"tailwind": {
				"tailwindcss": "4.3.3",
				"@tailwindcss/vite": "4.3.3",
				"@tailwindcss/typography": "0.5.20"
			},
			"maplibre": {
				"maplibre-gl": "5.24.0"
			}
		}
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"esbuild": "^0.28.2",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"typescript-editor-lsp": "npm:typescript@6.0.3"
	},
	"dependencies": {
		"@storybook/addon-themes": "^10.6.0",
		"@storybook/tanstack-react": "^10.6.0",
		"@tanstack/react-router": "^1.170.34",
		"@tanstack/react-start": "^1.168.51",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/react-virtual": "^3.14.11",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"input-otp": "^1.5.0",
		"react-resizable-panels": "^4.12.4",
		"rehype-pretty-code": "^0.14.5",
		"sonner": "^2.0.8",
		"storybook": "^10.6.0",
		"wrangler": "^4.130.0",
		"zod": "^4.6.1"
	}
}
